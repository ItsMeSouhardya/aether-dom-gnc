{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/aether-dom/cdom.schema.v0.3.0.json",
  "title": "CdomDocumentV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "branches",
    "characters",
    "events",
    "scenes",
    "shots",
    "assets",
    "layers",
    "audioTracks",
    "bindings",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.3.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "revision",
        "activeBranchId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "activeBranchId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "parentId",
          "baseRevision",
          "headRevision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "baseRevision": {
            "type": "integer",
            "minimum": 0
          },
          "headRevision": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "traits",
          "dialect",
          "constraints"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "traits": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "dialect": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "style",
              "forbiddenTerms"
            ],
            "properties": {
              "style": {
                "type": "string"
              },
              "forbiddenTerms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "type",
                "limb",
                "effectiveFromEventId",
                "resolvedByEventId"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string"
                },
                "limb": {
                  "type": "string",
                  "minLength": 1
                },
                "effectiveFromEventId": {
                  "type": "string",
                  "minLength": 1
                },
                "resolvedByEventId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sceneId",
          "order",
          "kind",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sceneId": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "eventIds",
          "shotIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "eventIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "shotIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sceneId",
          "durationMs",
          "camera",
          "layerIds",
          "audioTrackIds",
          "layoutOverrides"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sceneId": {
            "type": "string",
            "minLength": 1
          },
          "durationMs": {
            "type": "integer",
            "minimum": 1
          },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "aspectRatio",
              "position",
              "fovDeg"
            ],
            "properties": {
              "aspectRatio": {
                "enum": [
                  "16:9",
                  "9:16",
                  "1:1"
                ]
              },
              "position": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                }
              },
              "fovDeg": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "layerIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "audioTrackIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "layoutOverrides": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "layerTransforms": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y",
                      "z",
                      "scale",
                      "rotationDeg"
                    ],
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "z": {
                        "type": "number"
                      },
                      "scale": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "rotationDeg": {
                        "type": "number"
                      }
                    }
                  }
                }
              },
              "required": [
                "layerTransforms"
              ],
              "additionalProperties": false
            }
          },
          "audio": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tension"
            ],
            "properties": {
              "tension": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "uri",
          "rights"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "svg",
              "raster",
              "audio",
              "video",
              "json"
            ]
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "rights": {
            "enum": [
              "project_original",
              "licensed",
              "ai_generated",
              "unknown"
            ]
          },
          "name": {
            "type": "string"
          },
          "sourceUri": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "shotId",
          "kind",
          "assetId",
          "characterId",
          "pose",
          "transform"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "shotId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "svg_plane",
              "character_sprite",
              "raster_plane",
              "rig"
            ]
          },
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "characterId": {
            "type": [
              "string",
              "null"
            ]
          },
          "pose": {
            "type": [
              "string",
              "null"
            ]
          },
          "transform": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "z",
              "scale",
              "rotationDeg"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "rotationDeg": {
                "type": "number"
              }
            }
          },
          "name": {
            "type": "string"
          },
          "visible": {
            "type": "boolean"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "keyframes": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "timeMs",
                "transform"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "timeMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "transform": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "z",
                    "scale",
                    "rotationDeg"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    },
                    "scale": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "rotationDeg": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "audioTracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "shotId",
          "kind",
          "assetId",
          "gainDb",
          "boundLayerId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "shotId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "music",
              "foley",
              "dialogue"
            ]
          },
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "gainDb": {
            "type": "number"
          },
          "boundLayerId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target",
          "mapping"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "required": [
              "entityId",
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "entityId": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "target": {
            "type": "object",
            "required": [
              "entityId",
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "entityId": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "mapping": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "identity"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "inputMin",
                  "inputMax",
                  "outputMin",
                  "outputMax"
                ],
                "properties": {
                  "kind": {
                    "const": "linear"
                  },
                  "inputMin": {
                    "type": "number"
                  },
                  "inputMax": {
                    "type": "number"
                  },
                  "outputMin": {
                    "type": "number"
                  },
                  "outputMax": {
                    "type": "number"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createdBy",
        "generatedAssets",
        "notes"
      ],
      "properties": {
        "createdBy": {
          "type": "string",
          "minLength": 1
        },
        "generatedAssets": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
