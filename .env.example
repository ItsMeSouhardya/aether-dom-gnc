# Optional server-only setting. Copy to apps/web/.env.local if changing the API port.
# No secrets or external services are needed.
AETHER_API_ORIGIN=http://127.0.0.1:8000

# API process environment, set in its terminal (not loaded from the web env file):
# $env:AETHER_DATABASE_PATH='data/aether-dom.sqlite3'
# Relative database paths resolve against the workspace root. Default shown above.
# Optional API listener override: $env:AETHER_API_PORT='8000'
