{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForkBranchCommand",
  "type": "object", "additionalProperties": false,
  "required": ["commandId", "op", "projectId", "sourceBranchId", "expectedRevision", "newBranchId", "name", "actor", "reason"],
  "$defs": {
    "routeId": {"type":"string", "pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$(?![\\s\\S])"},
    "actor": {"type":"object", "additionalProperties":false, "required":["kind","id"], "properties":{"kind":{"const":"human"},"id":{"type":"string","minLength":1,"maxLength":128}}}
  },
  "properties": {
    "commandId": {"type":"string","minLength":1,"maxLength":128},
    "op": {"const":"forkBranch"},
    "projectId": {"$ref":"#/$defs/routeId"},
    "sourceBranchId": {"$ref":"#/$defs/routeId"},
    "expectedRevision": {"type":"integer","minimum":0,"maximum":9007199254740991},
    "newBranchId": {"$ref":"#/$defs/routeId"},
    "name": {"type":"string","minLength":1,"maxLength":80},
    "actor": {"$ref":"#/$defs/actor"},
    "reason": {"type":"string","minLength":1,"maxLength":500}
  }
}
