{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/aether-dom/command.schema.v0.7.0.json",
  "title": "CdomCommand",
  "type": "object",
  "$defs": {
    "envelope": {
      "type": "object",
      "required": [
        "commandId",
        "projectId",
        "branchId",
        "expectedRevision",
        "actor",
        "reason"
      ],
      "properties": {
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "branchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "human"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotationDeg": {
          "type": "number"
        }
      }
    },
    "assetEvidenceArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights",
        "expectedAssetUri",
        "expectedSourceUri",
        "creator",
        "source",
        "license",
        "attribution",
        "permissions",
        "lineage",
        "consents",
        "evidence"
      ],
      "properties": {
        "rights": {
          "enum": [
            "project_original",
            "licensed",
            "ai_generated",
            "unknown"
          ]
        },
        "expectedAssetUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^assets/[A-Za-z0-9_./-]+$"
        },
        "expectedSourceUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^assets/[A-Za-z0-9_./-]+$"
        },
        "creator": {
          "type": "string",
          "maxLength": 2000
        },
        "source": {
          "type": "string",
          "maxLength": 2000
        },
        "license": {
          "type": "string",
          "maxLength": 2000
        },
        "attribution": {
          "type": "string",
          "maxLength": 2000
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "private_preview",
            "public_distribution",
            "commercial_pack"
          ],
          "properties": {
            "private_preview": {
              "enum": [
                "allowed",
                "denied",
                "unknown"
              ]
            },
            "public_distribution": {
              "enum": [
                "allowed",
                "denied",
                "unknown"
              ]
            },
            "commercial_pack": {
              "enum": [
                "allowed",
                "denied",
                "unknown"
              ]
            }
          }
        },
        "lineage": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider",
                "model",
                "parentSha256"
              ],
              "properties": {
                "provider": {
                  "type": "string",
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
                },
                "model": {
                  "type": "string",
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
                },
                "parentSha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        },
        "consents": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "applicability",
              "subject",
              "status",
              "uses",
              "evidenceHashes"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "voice",
                  "likeness"
                ]
              },
              "applicability": {
                "enum": [
                  "not_applicable",
                  "unknown",
                  "required"
                ]
              },
              "subject": {
                "type": "string",
                "maxLength": 256
              },
              "status": {
                "enum": [
                  "allowed",
                  "denied",
                  "unknown"
                ]
              },
              "uses": {
                "type": "array",
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "private_preview",
                    "public_distribution",
                    "commercial_pack"
                  ]
                }
              },
              "evidenceHashes": {
                "type": "array",
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                }
              }
            }
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "voice"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "likeness"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "text"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 256,
                "minLength": 1,
                "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
              },
              "text": {
                "type": "string",
                "maxLength": 65536,
                "minLength": 1,
                "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "op",
            "targetId",
            "args"
          ],
          "properties": {
            "op": {
              "const": "setLayerPose"
            },
            "targetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pose"
              ],
              "properties": {
                "pose": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "op",
            "targetId",
            "args"
          ],
          "properties": {
            "op": {
              "const": "recordConstraintRecovery"
            },
            "targetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "eventId",
                "sceneId",
                "order",
                "description"
              ],
              "properties": {
                "eventId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "sceneId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "order": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "op",
            "targetId",
            "args"
          ],
          "properties": {
            "op": {
              "const": "setLayerTransform"
            },
            "targetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "args": {
              "$ref": "#/$defs/transform"
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "enum": [
                "undo",
                "redo"
              ]
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "op",
            "targetId",
            "args"
          ],
          "properties": {
            "op": {
              "const": "setShotCamera"
            },
            "targetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "camera": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "aspectRatio": {
                      "enum": [
                        "16:9",
                        "9:16",
                        "1:1"
                      ]
                    },
                    "position": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": -1000,
                          "maximum": 1000
                        },
                        "y": {
                          "type": "number",
                          "minimum": -1000,
                          "maximum": 1000
                        },
                        "z": {
                          "type": "number",
                          "minimum": 0.1,
                          "maximum": 1000
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "z"
                      ]
                    },
                    "fovDeg": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 120
                    }
                  },
                  "required": [
                    "aspectRatio",
                    "position",
                    "fovDeg"
                  ]
                }
              },
              "required": [
                "camera"
              ]
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "op",
            "targetId",
            "args"
          ],
          "properties": {
            "op": {
              "const": "setLayerAppearance"
            },
            "targetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "visible": {
                  "type": "boolean"
                },
                "opacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [],
              "minProperties": 1
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "op",
            "targetId",
            "args"
          ],
          "properties": {
            "op": {
              "const": "importSvgLayer"
            },
            "targetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "assetId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "layerId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "\\S"
                },
                "rights": {
                  "enum": [
                    "project_original",
                    "licensed",
                    "unknown"
                  ]
                },
                "svg": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 262144
                }
              },
              "required": [
                "assetId",
                "layerId",
                "name",
                "rights",
                "svg"
              ]
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "op",
            "targetId",
            "args"
          ],
          "properties": {
            "op": {
              "const": "editSvgElement"
            },
            "targetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "elementId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "attributes": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 32,
                  "propertyNames": {
                    "maxLength": 64
                  },
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 16384
                  }
                }
              },
              "required": [
                "elementId",
                "attributes"
              ]
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "op",
            "targetId",
            "args"
          ],
          "properties": {
            "op": {
              "const": "setLayerKeyframe"
            },
            "targetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "keyframeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "timeMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "transform": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "z",
                    "scale",
                    "rotationDeg"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    },
                    "scale": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "rotationDeg": {
                      "type": "number"
                    }
                  }
                }
              },
              "required": [
                "keyframeId",
                "timeMs",
                "transform"
              ]
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "op",
            "targetId",
            "args"
          ],
          "properties": {
            "op": {
              "const": "deleteLayerKeyframe"
            },
            "targetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "keyframeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": [
                "keyframeId"
              ]
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "op",
            "targetId",
            "args"
          ],
          "properties": {
            "op": {
              "const": "setShotTension"
            },
            "targetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tension"
              ],
              "properties": {
                "tension": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "required": [
        "op",
        "targetId",
        "args"
      ],
      "properties": {
        "op": {
          "const": "approveProposal"
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      }
    },
    {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "op",
            "targetId",
            "args"
          ],
          "properties": {
            "op": {
              "const": "setShotLayoutOverride"
            },
            "targetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "aspectRatio",
                "layerTransforms"
              ],
              "properties": {
                "aspectRatio": {
                  "const": "9:16"
                },
                "layerTransforms": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "maxProperties": 64,
                  "propertyNames": {
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "z": {
                        "type": "number"
                      },
                      "scale": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "rotationDeg": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "z",
                      "scale",
                      "rotationDeg"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        },
        {
          "type": "object",
          "required": [
            "op",
            "targetId",
            "args"
          ],
          "properties": {
            "op": {
              "const": "setAssetEvidence"
            },
            "targetId": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
            },
            "args": {
              "$ref": "#/$defs/assetEvidenceArgs"
            }
          }
        }
      ]
    }
  ]
}
