{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/aether-dom/ProposalPayload.schema.v0.1.0.json",
  "title": "ProposalPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operations",
    "evidenceNodeIds",
    "explanation"
  ],
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "title": "ProposalOperation",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "targetId",
              "args"
            ],
            "properties": {
              "op": {
                "const": "setLayerTransform"
              },
              "targetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "args": {
                "$ref": "#/$defs/transform"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "targetId",
              "args"
            ],
            "properties": {
              "op": {
                "const": "setLayerPose"
              },
              "targetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pose"
                ],
                "properties": {
                  "pose": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "\\S"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "targetId",
              "args"
            ],
            "properties": {
              "op": {
                "const": "setLayerAppearance"
              },
              "targetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "visible": {
                    "type": "boolean"
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [],
                "minProperties": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "targetId",
              "args"
            ],
            "properties": {
              "op": {
                "const": "setShotCamera"
              },
              "targetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "camera": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "aspectRatio": {
                        "enum": [
                          "16:9",
                          "9:16",
                          "1:1"
                        ]
                      },
                      "position": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "x": {
                            "type": "number",
                            "minimum": -1000,
                            "maximum": 1000
                          },
                          "y": {
                            "type": "number",
                            "minimum": -1000,
                            "maximum": 1000
                          },
                          "z": {
                            "type": "number",
                            "minimum": 0.1,
                            "maximum": 1000
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "z"
                        ]
                      },
                      "fovDeg": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 120
                      }
                    },
                    "required": [
                      "aspectRatio",
                      "position",
                      "fovDeg"
                    ]
                  }
                },
                "required": [
                  "camera"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "targetId",
              "args"
            ],
            "properties": {
              "op": {
                "const": "setShotTension"
              },
              "targetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tension"
                ],
                "properties": {
                  "tension": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        ]
      },
      "maxItems": 8,
      "minItems": 1
    },
    "evidenceNodeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 32,
      "minItems": 0,
      "uniqueItems": true
    },
    "explanation": {
      "type": "string",
      "maxLength": 4000,
      "minLength": 1
    }
  },
  "$defs": {
    "envelope": {
      "type": "object",
      "required": [
        "commandId",
        "projectId",
        "branchId",
        "expectedRevision",
        "actor",
        "reason"
      ],
      "properties": {
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "branchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "human"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotationDeg": {
          "type": "number"
        }
      }
    }
  }
}
