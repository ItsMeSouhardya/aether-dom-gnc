{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ThreeWayDiff", "type":"object", "additionalProperties":false,
  "required":["projectId","base","left","right","changes","conflictCount"],
  "$defs":{
    "routeId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$(?![\\s\\S])"},
    "BranchRevision":{"type":"object","additionalProperties":false,"required":["branchId","revision"],"properties":{"branchId":{"$ref":"#/$defs/routeId"},"revision":{"type":"integer","minimum":0,"maximum":9007199254740991}}},
    "JsonValue":{"anyOf":[{"type":"null"},{"type":"boolean"},{"type":"number"},{"type":"string"},{"type":"array","items":{"$ref":"#/$defs/JsonValue"}},{"type":"object","additionalProperties":{"$ref":"#/$defs/JsonValue"}}]},
    "BranchChange":{"type":"object","additionalProperties":false,"required":["collection","entityId","path","basePresent","leftPresent","rightPresent","base","left","right","status"],"properties":{
      "collection":{"enum":["document","project","provenance","characters","events","scenes","shots","assets","layers","audioTracks","bindings"]},
      "entityId":{"type":"string","minLength":1},"path":{"type":"string","minLength":1,"pattern":"^/([^~]|~[01])*$"},
      "basePresent":{"type":"boolean"},"leftPresent":{"type":"boolean"},"rightPresent":{"type":"boolean"},
      "base":{"$ref":"#/$defs/JsonValue"},"left":{"$ref":"#/$defs/JsonValue"},"right":{"$ref":"#/$defs/JsonValue"},
      "status":{"enum":["left_only","right_only","same_change","conflict"]}
    }}
  },
  "properties":{
    "projectId":{"$ref":"#/$defs/routeId"},"base":{"$ref":"#/$defs/BranchRevision"},"left":{"$ref":"#/$defs/BranchRevision"},"right":{"$ref":"#/$defs/BranchRevision"},
    "changes":{"type":"array","maxItems":4096,"items":{"$ref":"#/$defs/BranchChange"}},"conflictCount":{"type":"integer","minimum":0,"maximum":4096}
  }
}
