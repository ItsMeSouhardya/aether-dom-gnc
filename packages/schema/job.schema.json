{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/aether-dom/Job.schema.v0.1.0.json",
  "title": "Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "projectId",
    "branchId",
    "baseRevision",
    "request",
    "inputHash",
    "provider",
    "modelVersion",
    "estimatedCost",
    "actualCost",
    "status",
    "attempt",
    "maxAttempts",
    "progress",
    "createdAt",
    "updatedAt",
    "leaseExpiresAt",
    "nextAttemptAt",
    "error",
    "result"
  ],
  "properties": {
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$(?![\\s\\S])"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$(?![\\s\\S])"
    },
    "branchId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$(?![\\s\\S])"
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "expectedRevision",
        "scopeIds",
        "allowedOps",
        "intent",
        "message"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scopeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 8,
          "minItems": 1,
          "uniqueItems": true
        },
        "allowedOps": {
          "type": "array",
          "items": {
            "title": "ProposalOpName",
            "enum": [
              "setLayerTransform",
              "setLayerPose",
              "setLayerAppearance",
              "setShotCamera",
              "setShotTension"
            ]
          },
          "maxItems": 5,
          "minItems": 1,
          "uniqueItems": true
        },
        "intent": {
          "enum": [
            "repair_pose",
            "move_right",
            "set_tension"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "provider": {
      "const": "local_mock"
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "estimatedCost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "const": 0
        },
        "currency": {
          "const": "USD"
        }
      }
    },
    "actualCost": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "currency"
          ],
          "properties": {
            "amount": {
              "const": 0
            },
            "currency": {
              "const": "USD"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "stale"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "maxAttempts": {
      "const": 3
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|\\+00:00)$(?![\\s\\S])"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|\\+00:00)$(?![\\s\\S])"
    },
    "leaseExpiresAt": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|\\+00:00)$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "nextAttemptAt": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|\\+00:00)$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "retryable": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "proposalId",
            "sha256"
          ],
          "properties": {
            "kind": {
              "const": "proposal"
            },
            "proposalId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$(?![\\s\\S])"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
