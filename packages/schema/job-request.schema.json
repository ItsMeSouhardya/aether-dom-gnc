{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/aether-dom/JobRequest.schema.v0.1.0.json",
  "title": "JobRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "expectedRevision",
    "scopeIds",
    "allowedOps",
    "intent",
    "message"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scopeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 8,
      "minItems": 1,
      "uniqueItems": true
    },
    "allowedOps": {
      "type": "array",
      "items": {
        "title": "ProposalOpName",
        "enum": [
          "setLayerTransform",
          "setLayerPose",
          "setLayerAppearance",
          "setShotCamera",
          "setShotTension"
        ]
      },
      "maxItems": 5,
      "minItems": 1,
      "uniqueItems": true
    },
    "intent": {
      "enum": [
        "repair_pose",
        "move_right",
        "set_tension"
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
