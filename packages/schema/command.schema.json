                  "properties": {
                    "aspectRatio": {
                      "enum": [
                        "16:9",
                        "9:16",
                        "1:1"
                      ]
                    },
                    "position": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": -1000,
                          "maximum": 1000
                        },
                        "y": {
                          "type": "number",
                          "minimum": -1000,
                          "maximum": 1000
                        },
                        "z": {
                          "type": "number",
                          "minimum": 0.1,
                          "maximum": 1000
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "z"
